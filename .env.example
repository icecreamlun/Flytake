# Google Photorealistic 3D Tiles. Use ONE of the two options and save as .env.local
# (never commit it). Restart `pnpm dev` after changing it.

# Option A: Google Maps Platform key with the "Map Tiles API" enabled.
# Restrict it to the Map Tiles API and your HTTP referrers (it ships to the browser).
VITE_GOOGLE_MAPS_API_KEY=

# Option B: Cesium ion access token (asset 2275207 = Google Photorealistic 3D Tiles).
# Used only when VITE_GOOGLE_MAPS_API_KEY is empty.
VITE_CESIUM_ION_TOKEN=
